# Copy to .env.local for local development. Keep real credentials out of Git.
DATABASE_URL=file:./data/menuly.db
# Google OAuth web client credentials and a long, random, stable session secret.
# AUTH_GOOGLE_ID=your-google-oauth-client-id
# AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# AUTH_SECRET=generate-a-long-random-secret
# For local development on localhost, trust the local host used by Auth.js.
# AUTH_TRUST_HOST=true
# Optional for the local development seed command: MENULY_DEV_SEED=yes

# For a remote application database, replace DATABASE_URL with its private HTTP(S) URL.
# DATABASE_URL=http://db.internal:8080
# DATABASE_AUTH_TOKEN=replace-with-token-if-required

# Optional: use only with a separate disposable remote test database.
# REMOTE_TEST_DATABASE_URL=http://remote-test.internal:8080
# REMOTE_TEST_DATABASE_AUTH_TOKEN=replace-with-test-token-if-required
# REMOTE_TEST_DATABASE_DISPOSABLE=yes
